# Copier ce fichier en .env.local et remplir les valeurs.
# En local, `npm run db:start` affiche l'URL et la clé « anon » du Supabase local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé publique (anon / publishable). Elle est protégée par les règles RLS de la base.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé « service role » : côté serveur UNIQUEMENT (invitations). Jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
