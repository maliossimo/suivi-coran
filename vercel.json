{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "chore/**": false,
      "docs/**": false,
      "refactor/**": false,
      "perf/**": false,
      "test/**": false,
      "dependabot/**": false
    }
  },
  "functions": {
    "api/moteur_tajwid.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,.next,src,e2e,supabase,public,docs,tests_python,.github}/**"
    }
  }
}
