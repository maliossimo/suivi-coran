{
  "name": "suivi-coran",
  "version": "1.16.0",
  "private": true,
  "description": "Suivi des cours de Coran : apprentissage et révision, espace élève, maître et admin.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "psql \"${DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_test.sql",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "version:correctif": "npm version patch --no-git-tag-version",
    "version:mineure": "npm version minor --no-git-tag-version",
    "version:majeure": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/amiri": "^5.2.0",
    "@sentry/nextjs": "^10.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": ">=0.460.0",
    "next": "^15.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "3.9.10",
    "supabase": "^2.22.6",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
